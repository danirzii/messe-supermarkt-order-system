}
`;

function patchServer() {
  let s = read('server.js');

  if (!s.includes('const DEFAULT_APP_SETTINGS =')) {
    const marker = "const DB_FILE = path.join(DATA_DIR, 'db.json');";
    s = replaceOnce(s, marker, marker + '\n' + DEFAULT_SETTINGS_BLOCK, 'DEFAULT_APP_SETTINGS');
  }

  if (!s.includes('settings: { ...DEFAULT_APP_SETTINGS }')) {
    s = s.replace(
      '      products: DEFAULT_PRODUCTS,\n      orders: []',
      '      products: DEFAULT_PRODUCTS,\n      settings: { ...DEFAULT_APP_SETTINGS },\n      orders: []'
    );
  }

  if (!s.includes('const normalizedSettings = normalizeAppSettings(db.settings);')) {
    const marker = "  if (!Array.isArray(db.orders)) { db.orders = []; changed = true; }\n\n";
    const insertion =
      "  if (!db.settings || typeof db.settings !== 'object') { db.settings = { ...DEFAULT_APP_SETTINGS }; changed = true; }\n" +
      "  const normalizedSettings = normalizeAppSettings(db.settings);\n" +
      "  if (JSON.stringify(db.settings) !== JSON.stringify(normalizedSettings)) { db.settings = normalizedSettings; changed = true; }\n\n";

    s = replaceOnce(s, marker, marker + insertion, 'settings migration');
  }

  const start = s.indexOf('function autoHideExpiredDisplayOrders');
  const end = s.indexOf('function productPayload', start);

  if (start === -1 || end === -1) {
    throw new Error('Konnte Display-Funktionsblock in server.js nicht finden. Wurde V6 schon ausgefuehrt?');
  }

  s = s.slice(0, start) + DISPLAY_FUNCTIONS_V7 + '\n' + s.slice(end);

  if (!s.includes("app.get('/api/settings'")) {
    const routes = `
app.get('/api/settings', (req, res) => {
  res.json(getAppSettings());
});

app.put('/api/settings', (req, res) => {
  try {
    const settings = updateAppSettings(req.body || {});
    io.emit('settings:changed');
    broadcast();
    res.json(settings);
  } catch (error) {
    sendError(res, error);
  }
});
`;

    s = insertBefore(s, "app.get('/api/dashboard', (req, res) => res.json(buildDashboard()));", routes, 'settings routes');
  }

  write('server.js', s);
}

function patchDisplay() {
  write('public/display.html', DISPLAY_HTML);
  write('public/display.js', DISPLAY_JS);
}

function patchSettingsPage() {
  write('public/settings.html', SETTINGS_HTML);
  write('public/settings.js', SETTINGS_JS);
}

function addNavLink(html, beforeText) {
  if (html.includes('/settings.html')) return html;

  if (html.includes(beforeText)) {
    return html.replace(beforeText, '<a href="/settings.html">Einstellungen</a>\n        ' + beforeText);
  }

  return html.replace('</nav>', '        <a href="/settings.html">Einstellungen</a>\n      </nav>');
}

function patchNavs() {
  if (exists('public/index.html')) {
    let index = read('public/index.html');
    index = addNavLink(index, '<a href="/display.html">Abholanzeige</a>');
    write('public/index.html', index);
  }

  if (exists('public/dashboard.html')) {
    let dashboard = read('public/dashboard.html');
    dashboard = addNavLink(dashboard, '<a href="/api/export/orders.csv">CSV Export</a>');
    write('public/dashboard.html', dashboard);
  }
}

function patchStyles() {
  let s = read('public/styles.css');

  if (!s.includes('Einstellungen V7 + zweisprachige Abholanzeige')) {
    s += CSS;
  }

  write('public/styles.css', s);
}

function main() {
  for (const target of TARGETS) assertFile(target);

  const backupDir = backupFiles();

  patchServer();
  patchDisplay();
  patchSettingsPage();
  patchNavs();
  patchStyles();

  console.log('Fertig: V7 Einstellungen und zweisprachige Abholanzeige wurden eingetragen.');
  console.log('Backup erstellt in: ' + backupDir);
  console.log('Danach Server neu starten und /display.html sowie /settings.html mit Strg+F5 neu laden.');
}

main();
